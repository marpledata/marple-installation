COMPOSE_PATH_ROOT=./data # TODO, where all data is stored

VERSION_INSIGHT=3.4.2 # TODO set latest version
VERSION_DB=3.4.2 # TODO set latest version

DEPLOYMENT="TODO, ask Marple team"

# Ports (Match nginx if applicable)
COMPOSE_PORT_INSIGHT=8000
COMPOSE_PORT_DB=8001
COMPOSE_PORT_IDP=8002
COMPOSE_PORT_TRINO=8080

# Garage settings
AWS_ACCESS_KEY=...  # TODO Copy `Key ID` during garage setup (see README / 2. Start Everything)
AWS_SECRET_KEY=... # TODO Copy `Secret key` during garage setup (see README / 2. Start Everything)

# Postgres settings -
POSTGRES_HOST=marple-postgres
POSTGRES_PORT=5432
POSTGRES_DB=marple
POSTGRES_USER=marple
POSTGRES_PASSWORD=secret

# Identity Provider Settings (offline)
IDP_PROVIDER="OFFLINE"

# Marple Insight Settings
MARPLE_API_WORKERS=2
MARPLE_AUTO_JOIN_WORKSPACE=False
MARPLE_AUTO_CREATE_WORKSPACE=False
MARPLE_LICENSING_SERVER_ENABLED=False
MARPLE_LOG_SHOULD_UPLOAD=False
MARPLE_POSTMARK_SEND_MAIL=False

# Marple DB Settings
MDB_API_WORKERS = 2
MDB_PATH_BACKUP = "s3://mdb/backup"
MDB_PATH_COLD = "s3://mdb/cold"
MDB_INGEST_WORKERS=2
MDB_INGEST_WORKERS_PER_WORKSPACE=2
MDB_INGEST_THREADS_PER_WORKER=8
MDB_AWS_ENDPOINT=http://marple-garage:3900
MDB_AWS_REGION=eu-central-1
MDB_LOG_SHOULD_UPLOAD=False
MDB_TRINO_HOST=http://marple-trino
MDB_TRINO_PORT=8080
MDB_LICENSING_SERVER_ENABLED=False

# Trino Settings
TRINO_SHARED_SECRET="not-important"
TRINO_QUERY_MAX_MEMORY="20GB"
# advised = 2x query.max-memory
TRINO_QUERY_MAX_TOTAL_MEMORY="40GB"