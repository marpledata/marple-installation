COMPOSE_PATH_ROOT=./data # TODO, where all data is stored

VERSION_INSIGHT=3.6.0 # TODO set latest version
VERSION_DB=3.8.0 # TODO set latest version

DEPLOYMENT="TODO, ask Marple team"
LOG_SHOULD_UPLOAD=False
LICENSING_SERVER_ENABLED=False # Ask the Marple team for an offline license


# Exposed Ports
COMPOSE_PORT_INSIGHT=8000
COMPOSE_PORT_DB=8001
COMPOSE_PORT_TRINO=8080


# Postgres settings
POSTGRES_HOST=marple-postgres
POSTGRES_PORT=5432
POSTGRES_DB=marple
POSTGRES_USER=marple
POSTGRES_PASSWORD=secret

# Object Storage settings
MDB_AWS_ENDPOINT=http://marple-garage:3900
MDB_AWS_REGION=eu-central-1
MDB_AWS_ACCESS_KEY= # TODO Copy `Key ID` during garage setup (see README / 3. Start Everything)
MDB_AWS_SECRET_KEY= # TODO Copy `Secret key` during garage setup (see README / 3. Start Everything)


# Identity Provider Settings (OFFLINE or OAUTH)
IDP_PROVIDER="OFFLINE"

# OIDC Settings, only relevent when using OAUTH as IDP provider
OIDC_DOMAIN= # TODO, link to IdP
OIDC_ISSUER= # TODO, link to IdP
OIDC_AUDIENCE= # TODO, link to IdP
OIDC_CLIENT= # TODO, link to IdP
OIDC_SCOPE= # TODO, link to IdP, default is "openid profile email"

# Marple Insight Settings
MARPLE_AUTO_JOIN_WORKSPACE=False
MARPLE_AUTO_CREATE_WORKSPACE=False
MARPLE_POSTMARK_SEND_MAIL=False

# Marple DB Settings
MDB_PATH_BACKUP="s3://mdb/backup"
MDB_PATH_COLD="s3://mdb/cold"
MDB_TRINO_HOST=http://marple-trino
MDB_TRINO_PORT=8080
MDB_UPLOAD_DIRECT_ENABLED=False

# Trino Settings
TRINO_SHARED_SECRET="not-important"

# ── Resource profile ─────────────────────────────────────────────
# Append ONE profile from ../profiles/ when creating .env:
#   cp .env.example .env && cat ../profiles/small.env >> .env
# Profiles: ../profiles/{small,medium,large}.env
# Docs:     ../profiles/README.md
#
# AIRGAP NOTE: marple-db runs ./start.sh all here, so the API server and the
# background workers share ONE container. The profile's MDB_MEM_LIMIT is sized
# for the API-only container of a split deployment and is too small combined.
# After appending the profile, override it at the bottom of .env, e.g. on 8 GB:
#   MDB_MEM_LIMIT=2.5g
# On a laptop with plenty of RAM, set every *_MEM_LIMIT=0 (unlimited) instead.
# ─────────────────────────────────────────────────────────────────
