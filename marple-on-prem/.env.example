COMPOSE_PATH_ROOT=./data # TODO, where all data is stored

VERSION_INSIGHT=3.8.4 # TODO set latest version
VERSION_DB=3.8.1 # TODO set latest version

DEPLOYMENT="TODO, ask Marple team"
LOG_SHOULD_UPLOAD=True # Set to False to turn off telemetry
LICENSING_SERVER_ENABLED=True # If set to False, ask the Marple team for an offline license


# Exposed Ports
COMPOSE_PORT_INSIGHT=8000
COMPOSE_PORT_DB=8001
COMPOSE_PORT_IDP=8002
COMPOSE_PORT_TRINO=8080


# Postgres settings
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=marple
POSTGRES_USER=marple
POSTGRES_PASSWORD=secret


# Object storage — S3-compatible (default: local Garage)
MDB_PATH_BACKUP="s3://mdb/backup"
MDB_PATH_COLD="s3://mdb/cold"
MDB_AWS_ENDPOINT=http://garage:3900
MDB_AWS_REGION=eu-central-1
MDB_AWS_ACCESS_KEY= # TODO Copy `Key ID` during garage setup (see README / 3. Start Everything)
MDB_AWS_SECRET_KEY= # TODO Copy `Secret key` during garage setup (see README / 3. Start Everything)

# Object storage — Azure Blob (use abfss:// paths instead of s3:// above)
# MDB_PATH_BACKUP="abfss://TODO-container@TODO-account.dfs.core.windows.net/backup"
# MDB_PATH_COLD="abfss://TODO-container@TODO-account.dfs.core.windows.net/cold"
MDB_AZURE_ACCOUNT_NAME="" # TODO, required when using abfss:// paths
MDB_AZURE_ACCOUNT_KEY="" # TODO, required when using abfss:// paths


# Identity Provider Settings (OFFLINE or OAUTH)
IDP_PROVIDER="OAUTH"

# Default Dex configuration
OIDC_DOMAIN="https://dex.marple.example.com" # TODO, link to IdP Issuer
OIDC_ISSUER="https://dex.marple.example.com" # TODO, link to IdP Issuer
OIDC_AUDIENCE="marple-client"
OIDC_CLIENT="marple-client"
OIDC_SCOPE="openid profile email"

# Default Keycloak configuration
# KC_BOOTSTRAP_ADMIN_USERNAME=admin@marpledata.com
# KC_BOOTSTRAP_ADMIN_PASSWORD=password
# OIDC_DOMAIN="https://test.keycloak.marpledata.com" # TODO, link to IdP Issuer
# OIDC_ISSUER="https://test.keycloak.marpledata.com" # TODO, link to IdP Issuer
# OIDC_AUDIENCE="account"
# OIDC_CLIENT="marple-client"
# OIDC_SCOPE="openid profile email"

# Marple Insight Settings
MARPLE_PUBLIC_URL=https://insight.marple.example.com # TODO, link to insight host, e.g. insight.{customer}.com
MARPLE_AUTO_JOIN_WORKSPACE=False
MARPLE_AUTO_CREATE_WORKSPACE=False
MARPLE_POSTMARK_SEND_MAIL=False

# Marple DB Settings
MDB_TRINO_HOST="query.db.marple.example.com" # TODO, link to trino host, e.g. trino.{customer}.com
MDB_TRINO_PORT=443

# Trino Settings
TRINO_SHARED_SECRET="not-important"

# ── Resource profile ─────────────────────────────────────────────
# Append ONE profile from ../profiles/ when creating .env:
#   cp .env.example .env && cat ../profiles/medium.env >> .env
# Profiles: ../profiles/{small,medium,large}.env
# Docs:     ../profiles/README.md
# This sets the Trino query budget, container *_LIMIT caps and worker counts
# for both the Insight and DB services (which run split web + worker here).
# ─────────────────────────────────────────────────────────────────
