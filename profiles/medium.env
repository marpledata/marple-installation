# =============================================================================
# RESOURCE PROFILE: medium
# Target host: 4 CPU / 16 GB RAM  (leaves ~1 GB for the OS and dockerd)
# Total capped container budget: ~14 GB
#
# Append this file to your .env when provisioning (see profiles/README.md):
#   cp .env.example .env && cat ../profiles/medium.env >> .env
# =============================================================================

# ── Container limits (memory in bytes suffix g/m, cpus in cores) ─────────────
# 0 / unset means unlimited. These are enforced by docker compose deploy.resources.
TRINO_MEM_LIMIT=4g
TRINO_CPU_LIMIT=2
MDB_MEM_LIMIT=1g
MDB_CPU_LIMIT=0
MDB_WORKER_MEM_LIMIT=4g
MDB_WORKER_CPU_LIMIT=0
MARPLE_MEM_LIMIT=2g
MARPLE_CPU_LIMIT=0
MARPLE_QUEUE_MEM_LIMIT=3g
MARPLE_QUEUE_CPU_LIMIT=0

# ── Trino query budget ───────────────────────────────────────────────────────
# Must fit inside TRINO_MEM_LIMIT (JVM heap ≈ 80% of container with our jvm.config):
#   TRINO_QUERY_MAX_MEMORY_PER_NODE + TRINO_HEAP_HEADROOM_PER_NODE < JVM heap < TRINO_MEM_LIMIT
TRINO_QUERY_MAX_MEMORY=1GB
TRINO_QUERY_MAX_MEMORY_PER_NODE=1GB
TRINO_HEAP_HEADROOM_PER_NODE=512MB
TRINO_QUERY_MAX_TOTAL_MEMORY=1.5GB

# ── Marple DB workers (muhandis) ─────────────────────────────────────────────
MDB_API_WORKERS=2
MDB_HEATING_WORKERS=2
MDB_COOLING_WORKERS=1
MDB_ICEBERG_WORKERS=4
MDB_COOLING_THREADS_PER_WORKER=4
MDB_DB_POOL_MAX_SIZE=12
# Only used when INGEST_MANAGER=ingestion_queue (on-prem / airgap, not aws_batch)
MDB_INGEST_WORKERS=2
MDB_INGEST_WORKERS_PER_WORKSPACE=1
MDB_INGEST_THREADS_PER_WORKER=8

# ── Marple Insight workers ───────────────────────────────────────────────────
MARPLE_API_WORKERS=3
MARPLE_PROCRASTINATE_WORKERS=3
