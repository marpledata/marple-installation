# =============================================================================
# RESOURCE PROFILE: large
# Target host: 8 CPU / 32 GB RAM  (leaves headroom for the OS and dockerd)
# Total capped container budget: ~24 GB
#
# Append this file to your .env when provisioning (see profiles/README.md):
#   cp .env.example .env && cat ../profiles/large.env >> .env
# =============================================================================

# ── Container limits (memory in bytes suffix g/m, cpus in cores) ─────────────
# 0 / unset means unlimited. These are enforced by docker compose deploy.resources.
TRINO_MEM_LIMIT=8g
TRINO_CPU_LIMIT=4
MDB_MEM_LIMIT=1g
MDB_CPU_LIMIT=1
MDB_WORKER_MEM_LIMIT=6g
MDB_WORKER_CPU_LIMIT=4
MARPLE_MEM_LIMIT=3g
MARPLE_CPU_LIMIT=2
MARPLE_QUEUE_MEM_LIMIT=4g
MARPLE_QUEUE_CPU_LIMIT=2

# ── Trino query budget ───────────────────────────────────────────────────────
# Must fit inside TRINO_MEM_LIMIT:
#   TRINO_QUERY_MAX_MEMORY_PER_NODE + TRINO_HEAP_HEADROOM_PER_NODE < JVM heap < TRINO_MEM_LIMIT
TRINO_QUERY_MAX_MEMORY=2GB
TRINO_QUERY_MAX_MEMORY_PER_NODE=2GB
TRINO_HEAP_HEADROOM_PER_NODE=1GB
TRINO_QUERY_MAX_TOTAL_MEMORY=4GB

# ── Marple DB workers (muhandis) ─────────────────────────────────────────────
MDB_API_WORKERS=4
MDB_HEATING_WORKERS=4
MDB_COOLING_WORKERS=2
MDB_ICEBERG_WORKERS=8
MDB_COOLING_THREADS_PER_WORKER=4
MDB_DB_POOL_MAX_SIZE=16
# Only used when INGEST_MANAGER=ingestion_queue (on-prem / airgap, not aws_batch)
MDB_INGEST_WORKERS=4
MDB_INGEST_WORKERS_PER_WORKSPACE=2
MDB_INGEST_THREADS_PER_WORKER=8

# ── Marple Insight workers ───────────────────────────────────────────────────
MARPLE_API_WORKERS=5
MARPLE_PROCRASTINATE_WORKERS=5
