# Deployment settings
MARPLE_CONTAINER_NAME=marple-insight # Unique name on server
MARPLE_VERSION=3.9.1

# Directory settings, where configuration files etc will be stored
DOCKER_PATH_ROOT=/srv/marple/insight
# Exports can be best served from a swap disk
DOCKER_EXPORTS_PATH=${DOCKER_PATH_ROOT}/exports

# Leave like this if you use postgres in docker
# Otherwise, set credentials of postgres server
MARPLE_POSTGRES_HOST=marple-postgres
MARPLE_POSTGRES_PORT=5432
MARPLE_POSTGRES_USER=marple
MARPLE_POSTGRES_PW=postgresindocker
MARPLE_POSTGRES_DB_NAME=marpledb

# Web server
MARPLE_PORT=8000
MARPLE_DEPLOYMENT="TODO, ask Marple team"
MARPLE_PUBLIC_URL="TODO, e.g. https://marple.mycompany.com"

# Identity provider (IdP)
MARPLE_AUTH_PROVIDER=OFFLINE # Set to "OAUTH" to enable custom IdP
MARPLE_OAUTH_DOMAIN="TODO"
MARPLE_OAUTH_ISSUER="TODO"
MARPLE_OAUTH_API_AUDIENCE="TODO"
MARPLE_OAUTH_APP_CLIENT_ID="TODO"
MARPLE_OAUTH_SCOPE="TODO"
MARPLE_OAUTH_GROUP_KEY="" # Optionally, to assign users to workspaces from IdP
MARPLE_OAUTH_METADATA_SEED="{}" # Optional JSON to seed or override OIDC metadata discovery

# Workspaces and sign-up behaviour
MARPLE_AUTO_JOIN_WORKSPACE=False
MARPLE_AUTO_CREATE_WORKSPACE=False

# Superuser
MARPLE_SUPERUSER_ID=""    # has to be a sub from your IdP
MARPLE_SUPERUSER_GROUP="" # has to be a group from your IdP
MARPLE_SUPERUSER_VISIBLE=True

MARPLE_POSTMARK_SEND_MAIL=True

# Query timeout (seconds) for connections to the underlying database
MARPLE_CONNECTION_QUERY_TIMEOUT=120

# ── Resource profile ─────────────────────────────────────────────
# Append ONE profile from ../profiles/ when creating .env:
#   cp .env.example .env && cat ../profiles/small.env >> .env
# Profiles: ../profiles/{small,medium,large}.env
# Docs:     ../profiles/README.md
# This sets the container *_LIMIT caps and worker counts (MARPLE_API_WORKERS,
# MARPLE_PROCRASTINATE_WORKERS). MDB_* / TRINO_* entries are ignored here.
# ─────────────────────────────────────────────────────────────────
