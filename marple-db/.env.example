# Deployment settings
MDB_CONTAINER_NAME=marple-db # Unique name on server
TRINO_CONTAINER_NAME=trino # Unique name on server
MDB_VERSION=3.8.0
MDB_DEPLOYMENT="TODO, ask Marple team"

# Persistent storage, where files and logs will be stored
DOCKER_PATH_ROOT=/srv/marple/db

# Leave like this if you use postgres in docker
# Otherwise, set credentials of postgres server
MDB_DB_HOST=marpledb-postgres
MDB_DB_USER=marple
MDB_DB_PASSWORD=postgresindocker
MDB_DB_NAME=marpledb
MDB_DB_PORT=5432

# Trino
MDB_TRINO_HOST="TODO, e.g. query.db.{customer}.marpledata.com"
MDB_TRINO_PORT=443

# Web server
MDB_PORT=8000
TRINO_PORT=8080

TRINO_SHARED_SECRET="TODO"

# Ingestion manager: "ingestion_queue" (default, runs ingestion in the worker container)
# or "aws_batch" (offloads ingestion to AWS Batch; VPC only). Uncomment to use Batch:
# MDB_INGEST_MANAGER=aws_batch
# MDB_AWS_BATCH_JOB_QUEUE="TODO, e.g. staging-ingestion-ec2-queue"
# MDB_AWS_BATCH_JOB_DEFINITION="TODO, e.g. staging-ingestion-job-definition"

# ── Resource profile ─────────────────────────────────────────────
# Append ONE profile from ../profiles/ when creating .env:
#   cp .env.example .env && cat ../profiles/small.env >> .env
# Profiles: ../profiles/{small,medium,large}.env
# Docs:     ../profiles/README.md
# This sets the Trino query budget, container *_LIMIT caps and worker counts.
# ─────────────────────────────────────────────────────────────────
