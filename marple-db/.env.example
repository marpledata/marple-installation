# Deployment settings
MDB_CONTAINER_NAME=marple-db # Unique name on server
TRINO_CONTAINER_NAME=trino # Unique name on server
MDB_VERSION=3.8.0
MDB_DEPLOYMENT="TODO, ask Marple team"

# Persistent storage, where files and logs will be stored
DOCKER_PATH_ROOT=/srv/marple/db

# Leave like this if you use postgres in docker
# Otherwise, set credentials of postgres server
MDB_DB_HOST=marpledb-postgres
MDB_DB_USER=marple
MDB_DB_PASSWORD=postgresindocker
MDB_DB_NAME=marpledb
MDB_DB_PORT=5432

# Trino
MDB_TRINO_HOST="TODO, e.g. query.db.{customer}.marpledata.com"
MDB_TRINO_PORT=443

# Web server
MDB_PORT=8000
TRINO_PORT=8080

TRINO_SHARED_SECRET="TODO"

# Object storage — S3 (or S3-compatible)
MDB_PATH_BACKUP="s3://TODO-bucket/backup" # TODO
MDB_PATH_COLD="s3://TODO-bucket/cold" # TODO
MDB_AWS_ACCESS_KEY="TODO"
MDB_AWS_SECRET_KEY="TODO"
MDB_AWS_ENDPOINT="" # leave empty for AWS; set for Garage/MinIO
MDB_AWS_REGION=eu-central-1 # TODO if not eu-central-1

# Object storage — Azure Blob (use abfss:// paths instead of s3:// above)
# MDB_PATH_BACKUP="abfss://TODO-container@TODO-account.dfs.core.windows.net/backup"
# MDB_PATH_COLD="abfss://TODO-container@TODO-account.dfs.core.windows.net/cold"
MDB_AZURE_ACCOUNT_NAME="" # TODO, required when using abfss:// paths
MDB_AZURE_ACCOUNT_KEY="" # TODO, required when using abfss:// paths

# Telemetry
MDB_LOG_SHOULD_UPLOAD=True

# Identity provider (VPC typically uses OAUTH)
MDB_IDP_PROVIDER=OAUTH
MDB_OIDC_DOMAIN="TODO" # e.g. https://your-tenant.auth0.com
MDB_OIDC_AUDIENCE="TODO"
MDB_OIDC_CLIENT="TODO"
MDB_OIDC_SCOPE="openid profile email"

# Ingestion (VPC default: AWS Batch; use ingestion_queue for on-prem / airgap)
MDB_INGEST_MANAGER=aws_batch
MDB_AWS_BATCH_JOB_QUEUE="TODO" # e.g. staging-ingestion-ec2-queue
MDB_AWS_BATCH_JOB_DEFINITION="TODO" # e.g. staging-ingestion-job-definition

# ── Resource profile ─────────────────────────────────────────────
# Append ONE profile from ../profiles/ when creating .env:
#   cp .env.example .env && cat ../profiles/small.env >> .env
# Profiles: ../profiles/{small,medium,large}.env
# Docs:     ../profiles/README.md
# This sets the Trino query budget, container *_LIMIT caps and worker counts.
# ─────────────────────────────────────────────────────────────────
